# lending-bank-gateway 环境变量示例
# 复制为 env.local 并填入真实值（env.local 不提交 git）
# 所有 GW_ 前缀变量由 pydantic-settings 自动映射到 app/core/config.py 中的 Settings 字段

# ── 数据库连接（docker-compose 中会拼接为 GW_DB_URL）──────────────────────────────
DB_USER=gateway
DB_PASS=changeme
DB_HOST=192.168.0.201
# 完整 URL 也可直接设置（优先级高于上面三个子变量在 docker-compose 中的拼接）
# GW_DB_URL=mysql+asyncmy://gateway:changeme@192.168.0.201:3306/lending_bank_gateway

# ── wedap 资金系统 ─────────────────────────────────────────────────────────────────
# 银行南向（放款/还款/归集/分发/状态/查询）：直连 baffle 或经 wedap gw-internal
# （Spring Cloud Gateway，Phase 1 无网关鉴权）。经 gw-internal 时 base_url 自带
# /lending-gw 前缀，client 不做路径改写：
#   直连 baffle:      WEDAP_BASE_URL=http://baffle:8021
#   经 gw-internal:   WEDAP_BASE_URL=http://<gw-internal>:8000/lending-gw
WEDAP_BASE_URL=http://baffle:8021
# wedap 请求超时秒数（可选，默认 10.0）
# GW_WEDAP_TIMEOUT_SECONDS=10.0
#
# flow-import 投递（recon→gateway→wedap 明细导入）凭证/开关，由 deploy.sh 透传：
# apikey 是 web2-core 应用层鉴权（FLOW_IMPORT_API_KEYS 白名单），与网关无关；
# WEDAP_IMPORT_BASE_URL 是 flow-import 独立 base（经 gw-internal 走
# http://<gw-internal>:8000/external/web2-core；留空=回落 WEDAP_BASE_URL）。
# WEDAP_IMPORT_API_KEY=lending-api-key-xxx
# WEDAP_IMPORT_BASE_URL=http://<gw-internal>:8000/external/web2-core
# WEDAP_IMPORT_BUCKET=wedap-dev-01
# WEDAP_STAGING_BUCKET=lending-wedap-staging
# WEDAP_PRESIGNED_ENABLED=true
# WEDAP_DELIVERY_ENABLED=true
# S3_ENDPOINT_URL=            # 空=真实 AWS S3；MinIO 填 http://host:9000
# RECON_BASE_URL=http://lending-recon-app:8040
# RECON_CALLBACK_HMAC_SECRET= # = recon RECON_S2S_HMAC_SECRET
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION（boto3 标准 env，仅 MinIO staging 需）

# ── S2S 鉴权 ──────────────────────────────────────────────────────────────────────
# 经 BFF `/internal/proxy/bank-gateway/...` 进来的调用方带的是
# `Authorization: Bearer <BFF 签的 svc JWT>`，不带 X-S2S-Token（BFF 出站透传白名单里
# 没有这个头）。配上 BFF base URL 即启用该通路的本地验签（RS256 + /internal/svc-jwks.json，
# aud=bank-gateway）；留空 = 只认下面的 X-S2S-Token，既有直连调用方零影响。
# BFF_BASE_URL=http://lending-console-bff:7018
GW_S2S_SECRET=changeme-shared-token
# 允许调用的服务白名单（逗号分隔，空=不校验 caller 身份）
GW_S2S_CALLERS=lending-lifecycel,lending-core,lending-recon

# ── wedap 入站回调 apikey（FU-GW-INBOUND-AUTH-WEDAP-CALLBACK）──────────────────────
# wedap→gateway 的 /api/v1/callbacks/wedap/transactions 与 /api/v1/recon/notify 由
# S2SMiddleware 的 callback 分支在 body 解析前用此 apikey 认证（外部 wedap 无 lending S2S
# token）；wedap 调用时带 `apikey` header。空=dev 降级放行（仅 local/test）；非 local/test
# 未配则启动 fail-fast（GW_ENV 见下），prod/dev-hw 必配。
GW_WEDAP_CALLBACK_API_KEY=changeme-wedap-callback-key

# ── 回调地址 ──────────────────────────────────────────────────────────────────────
# wedap 回调后转发 lifecycle 的地址（可选，默认指向 lending-lifecycel:9000——仅同
# docker network 可解析该主机名时可用）。deploy.sh 从 CALLBACK_TARGET_LIFECYCLE_URL
# 注入容器 env GW_CALLBACK_TARGET_LIFECYCLE_URL。
# dev-hw：gateway 与 9000 不同 network 且 9000 端点挂 require_bff_service_jwt（直连必
# 401），必须走 BFF internal proxy（自动签 svc JWT）；BFF InternalGuard 只放行内网源 IP。
# 2026-08-12 起按容器名直连：admin-backend 撤 7018 宿主端口映射改多副本，宿主网关 IP
# 172.25.0.1 + docker-proxy 那条路会消失。compose 已把 gateway 加入 lending-network，
# 源 IP 变成 172.24.0.x，同样落 172.16/12 信任网段，InternalGuard 照过。
# FU-GW-DEVHW-LIFECYCLE-CB-URL-20260714-001。
# CALLBACK_TARGET_LIFECYCLE_URL=http://lending-console-bff:7018/internal/proxy/lending/api/v1/bank/transaction-callback

# ── S3 归档（可选）────────────────────────────────────────────────────────────────
# 使用 MinIO 等本地 S3 兼容存储时设置端点；留空则走 AWS 凭证链（IAM Role / env 变量）
GW_S3_ENDPOINT_URL=
# AWS 凭证：优先 IAM Role；本地/dev-hw 用 access key
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-east-1

# ── 运行时 ────────────────────────────────────────────────────────────────────────
GW_ENV=local
# outbox 最大重试次数（可选，默认 8）
# GW_OUTBOX_MAX_ATTEMPTS=8
# 数据库连接池大小（可选，默认 5/10）
# GW_DB_POOL_SIZE=5
# GW_DB_MAX_OVERFLOW=10

# ── worker 控制（随 API 进程 lifespan 启动）───────────────────────────────────────
# 是否启动后台 worker（outbox dispatcher + recon worker）；多副本部署下可按需关闭
# GW_WORKERS_ENABLED=true
# outbox dispatcher 每轮投递间隔秒数（可选，默认 5.0）
# GW_OUTBOX_INTERVAL_SECONDS=5.0
# recon worker 每轮摄取间隔秒数（可选，默认 30.0）
# GW_RECON_INTERVAL_SECONDS=30.0
# 对账文件本地归档目录（可选，默认 /srv/archive）
# GW_ARCHIVE_DIR=/srv/archive
# worker 崩溃后退避重启间隔秒数（可选，默认 5.0）
# GW_WORKER_RESTART_DELAY_SECONDS=5.0

# 账户守门人（平台账户白名单，FU-GW-ACCOUNT-GUARD）：off=不校验(默认) / observe=只记录 / enforce=403 拒
# 灰度 SOP：先 off 上线 → seed 白名单 → observe 跑 ≥1 完整业务周期抓漏配 → enforce
ACCOUNT_GUARD_MODE=
# admin 白名单登记端点(/api/v1/admin/platform-accounts)的调用方白名单（csv）。
# 空 = fail-closed 全拒（与 GW_S2S_CALLERS 的「空=不启用」语义相反，配置面从严）
ADMIN_CALLERS=
# per-service S2S token（caller1:token1,caller2:token2）。混合语义：表内 caller 强制专属
# token（密码学绑定身份），表外 caller 回退共享 GW_S2S_SECRET。启用 ADMIN_CALLERS 时
# 每个 admin caller 必须在此有专属 token（启动期 fail-fast），否则 caller 头可被共享
# secret 持有者伪造。
S2S_CALLER_TOKENS=

  "components": {
    "schemas": {
      "CollectRequest": {
        "properties": {
          "bizSeqNo": {
            "type": "string",
            "title": "Bizseqno"
          },
          "currencyCode": {
            "type": "string",
            "title": "Currencycode"
          },
          "txnAmount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Txnamount"
          },
          "totalAmount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Totalamount"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "bizSeqNo",
          "currencyCode"
        ],
        "title": "CollectRequest"
      },
      "DisbursementInfo": {
        "properties": {
          "txnAmount": {
            "type": "string",
            "title": "Txnamount"
          },
          "currencyCode": {
            "type": "string",
            "title": "Currencycode"
          },
          "userId": {
            "type": "string",
            "title": "Userid",
            "default": ""
          },
          "userName": {
            "type": "string",
            "title": "Username",
            "default": ""
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "txnAmount",
          "currencyCode"
        ],
        "title": "DisbursementInfo"
      },
      "DistributeRequest": {
        "properties": {
          "bizSeqNo": {
            "type": "string",
            "title": "Bizseqno"
          },
          "currencyCode": {
            "type": "string",
            "title": "Currencycode"
          },
          "recipients": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipients"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "bizSeqNo",
          "currencyCode"
        ],
        "title": "DistributeRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "P2PDisbursementRequest": {
        "properties": {
          "bizSeqNo": {
            "type": "string",
            "title": "Bizseqno"
          },
          "channelId": {
            "type": "string",
            "title": "Channelid",
            "default": ""
          },
          "transType": {
            "type": "string",
            "title": "Transtype",
            "default": ""
          },
          "disbursementInfo": {
            "$ref": "#/components/schemas/DisbursementInfo"
          },
          "lenders": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lenders"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "bizSeqNo",
          "disbursementInfo"
        ],
        "title": "P2PDisbursementRequest"
      },
      "P2PRepaymentRequest": {
        "properties": {
          "bizSeqNo": {
            "type": "string",
            "title": "Bizseqno"
          },
          "repaymentInfo": {
            "$ref": "#/components/schemas/RepaymentInfo"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "bizSeqNo",
          "repaymentInfo"
        ],
        "title": "P2PRepaymentRequest"
      },
      "RepaymentInfo": {
        "properties": {
          "txnAmount": {
            "type": "string",
            "title": "Txnamount"
          },
          "currencyCode": {
            "type": "string",
            "title": "Currencycode"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "txnAmount",
          "currencyCode"
        ],
        "title": "RepaymentInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Userlist",
            "type": "array"
          }
        },
        "required": [
          "bizSeqNo",
          "totalAmount",
          "currencyCode"
        ],
        "title": "BankFundsRequest",
        "type": "object"
      },
      "DisbursementInfo": {
        "properties": {
          "currencyCode": {
            "title": "Currencycode",
            "type": "string"
          },
          "txnAmount": {
            "title": "Txnamount",
            "type": "string"
          },
          "userId": {
            "default": "",
            "title": "Userid",
            "type": "string"
          },
          "userName": {
            "default": "",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "txnAmount",
          "currencyCode"
        ],
        "title": "DisbursementInfo",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "P2PDisbursementRequest": {
        "properties": {
          "bizSeqNo": {
            "title": "Bizseqno",
            "type": "string"
          },
          "channelId": {
            "default": "",
            "title": "Channelid",
            "type": "string"
          },
          "disbursementInfo": {
            "$ref": "#/components/schemas/DisbursementInfo"
          },
          "lenders": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Lenders",
            "type": "array"
          },
          "transType": {
            "default": "",
            "title": "Transtype",
            "type": "string"
          }
        },
        "required": [
          "bizSeqNo",
          "disbursementInfo"
        ],
        "title": "P2PDisbursementRequest",
        "type": "object"
      },
      "P2PRepaymentRequest": {
        "properties": {
          "bizSeqNo": {
            "title": "Bizseqno",
            "type": "string"
          },
          "repaymentInfo": {
            "$ref": "#/components/schemas/RepaymentInfo"
          }
        },
        "required": [
          "bizSeqNo",
          "repaymentInfo"
        ],
        "title": "P2PRepaymentRequest",
        "type": "object"
      },
      "RepaymentInfo": {
        "properties": {
          "currencyCode": {
            "title": "Currencycode",
            "type": "string"
          },
          "txnAmount": {
            "title": "Txnamount",
            "type": "string"
          }
        },
        "required": [
          "txnAmount",
          "currencyCode"
        ],
        "title": "RepaymentInfo",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },

    "/api/v1/admin/outbox/{outbox_id}/replay": {
      "post": {
        "description": "将 DEAD 状态的 outbox 行重置为 PENDING 以触发重新投递。\n\n- 行不存在或非 DEAD 状态 → 404 GW_404_OUTBOX\n- 成功 → ok({\"replayed\": outbox_id})",
        "operationId": "replay_outbox_api_v1_admin_outbox__outbox_id__replay_post",
        "parameters": [
          {
            "in": "path",
            "name": "outbox_id",
            "required": true,
            "schema": {
              "title": "Outbox Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Replay Outbox Api V1 Admin Outbox  Outbox Id  Replay Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Replay Outbox",
        "tags": [
          "admin"
        ]
      }
    },
